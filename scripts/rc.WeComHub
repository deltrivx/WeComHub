#!/bin/bash
# WeComHub 本地指令服务 启动脚本
# 由插件安装为 /etc/rc.d/rc.WeComHub，开机自动拉起；无需修改 /boot/config/go。
#
# 用法:
#   rc.WeComHub start|stop|restart|status
set -u

NAME="WeComHub"
PY="/usr/local/emhttp/plugins/WeComHub/wecom-hub-cmd.py"
CFG="/boot/config/plugins/WeComHub/wecom.hub.cfg"
LOG="/var/log/wecom-hub.log"

log() { echo "[$(date +%F %T)] $*" >>"$LOG" 2>/dev/null || true; }

running() { pgrep -f "python3 -u $PY" >/dev/null 2>&1; }

start() {
  running && { log "already running"; return 0; }
  [ -f "$CFG" ] && set -a && . "$CFG" 2>/dev/null && set +a
  [ -x "$PY" ] || { log "missing $PY"; return 1; }
  setsid python3 -u "$PY" >>"$LOG" 2>&1 </dev/null &
  log "started (pid=$!)"
}

stop() {
  pkill -f "wecom-hub-cmd.py" 2>/dev/null || true
  log "stopped"
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  status)  running && echo "$NAME is running" || echo "$NAME is stopped" ;;
  *)       echo "usage: $0 start|stop|restart|status"; exit 1 ;;
esac
