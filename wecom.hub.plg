<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "WeComHub">
<!ENTITY author "deltrivx">
<!ENTITY version "{VERSION}">
<!ENTITY launch "Settings/Notification">
<!ENTITY branch "main">
<!ENTITY gitURL "https://github.com/deltrivx/WeComHub/raw/&branch;/">
<!ENTITY pluginURL "https://github.com/deltrivx/WeComHub">
<!ENTITY supportURL "https://github.com/deltrivx/WeComHub/issues">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;"
        pluginURL="&pluginURL;" supportURL="&supportURL;" min="6.9.0" beta="false">

  <!-- WeComHub：Unraid 企业微信中枢
       设置 → 通知 可视化配置；系统通知推送企微 + 企微指令反向交互。
       所有归档由 GitHub Actions 云端构建，禁止本地打包后上传。 -->

  <CHANGES>
### {VERSION}
- 设置 → 通知 → 通知代理 可视化配置入口
- 系统通知经中转转发至企业微信
- 内置本地指令服务，接收企微反向调用
- 阵列启动钩子开机自启，不再依赖 /boot/config/go
- 插件页显示完整描述

### 1.1.3
- 配置持久化：快照逻辑移至程序本体，可覆盖存量用户

### 1.1.2
- 配置持久化：误删后重装自动从快照还原

### 1.1.1
- 修复升级覆盖用户凭据（删除残留 FILE 条目）

### 1.1.0
- 存量配置文件自动补 export（不影响用户的变量值）

### 1.0.9
- 修复通知完全失效：变量块后补 export，exec 才会传递变量给程序本体

### 1.0.8
- 修复指令服务鉴权失败（403），令牌改从通知代理配置读取
- 补全通知代理页面图标
- 通知正文与变量标签中文化

### 1.0.7
- 旧版升级自愈：检测到遗留 {0} 格式的 agent 文件时自动重建
- 安装钩子改用插件内模板作为生成源，消除双份维护

### 1.0.6
- 程序与配置解耦：升级插件不再丢失中转地址与令牌
- 安装时生成 agent 配置文件（含默认值，无 {0}），Test 不再报错
- 误删 agent 文件后重装可恢复

### 1.0.5
- agent 脚本注释全英文，修复 Test 按钮报 command not found
- 通知/指令配置分离，各自只有一个入口
- 不再预置任何值，任何设备安装后自行填写即可

### 1.0.4
- 修复通知代理页面读不到配置（部署带变量块的完整脚本）
- agents/WeComHub.xml 与 scripts/notify-agent.sh 保持单一真相源

### 1.0.3
- 新增 plugins/WeComHub/README.md，修复插件页「描述」列空白
- RESTART_ALLOW_PREFIX 支持 * 通配，允许重启任意容器，无需逐个配置
- 修复 rc.WeComHub 在 busybox date 下日志时间戳空白
- 修复 rc.WeComHub 启动时与旧实例抢 8181 端口

### 1.0.2
- 新增通知代理定义 agents/WeComHub.xml
- 修复 verify-release.sh 占位符正则与 txz 目录校验误报

### 1.0.1
- 通知 payload 对齐现役中转侧（token + text 核心字段）
- 指令服务固定 POST /exec 并统一返回 JSON
- 指令支持中文别名（状态/磁盘/温度/阵列/重启）
- 「允许重启的容器名前缀」可在设置页配置，留空即禁用 restart
- 未配置令牌时指令服务 fail closed
- 修复版本索引与更新检查的字段名不一致

### 1.0.0
- 初始版本
  </CHANGES>

  <FILE Name="/usr/local/emhttp/plugins/&name;/&name;.page" Mode="0755">
    <URL>&gitURL;&name;.page</URL>
    <MD5>{MD5_PAGE}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/assets/&name;.css" Mode="0644">
    <URL>&gitURL;assets/&name;.css</URL>
    <MD5>{MD5_CSS}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/assets/&name;.js" Mode="0644">
    <URL>&gitURL;assets/&name;.js</URL>
    <MD5>{MD5_JS}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/wecom-hub-save.php" Mode="0755">
    <URL>&gitURL;wecom-hub-save.php</URL>
    <MD5>{MD5_SAVE}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/wecom-hub-update.php" Mode="0755">
    <URL>&gitURL;wecom-hub-update.php</URL>
    <MD5>{MD5_UPDATE}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/wecom-hub-notify-agent.sh" Mode="0755">
    <URL>&gitURL;wecom-hub-notify-agent.sh</URL>
    <MD5>{MD5_AGENT}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/wecom-hub-cmd.py" Mode="0755">
    <URL>&gitURL;wecom-hub-cmd.py</URL>
    <MD5>{MD5_CMD}</MD5>
  </FILE>
  <!-- 插件页描述列：Unraid 插件管理器读取 plugins/<name>/README.md -->
  <FILE Name="/usr/local/emhttp/plugins/&name;/README.md" Mode="0644">
    <URL>&gitURL;README.plugin.md</URL>
    <MD5>{MD5_README}</MD5>
  </FILE>
  <!-- 通知代理图标：NotificationAgents.page 读取 plugins/dynamix/icons/<小写名>.png -->
  <FILE Name="/usr/local/emhttp/plugins/dynamix/icons/wecomhub.png" Mode="0644">
    <URL>&gitURL;assets/icon-wecomhub.png</URL>
    <MD5>{MD5_ICON}</MD5>
  </FILE>
  <!-- 通知代理定义：安装后出現在 设置 → 通知 → 通知代理，可在页面内填写并测试 -->
  <FILE Name="/usr/local/emhttp/plugins/dynamix/agents/&name;.xml" Mode="0644">
    <URL>&gitURL;agents/&name;.xml</URL>
    <MD5>{MD5_AGENTXML}</MD5>
  </FILE>
  <FILE Name="/etc/rc.d/rc.&name;" Mode="0755">
    <URL>&gitURL;scripts/rc.&name;</URL>
    <MD5>{MD5_RC}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/scripts/event-started.sh" Mode="0755">
    <URL>&gitURL;scripts/event-started.sh</URL>
    <MD5>{MD5_EVENT}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/scripts/agent-config-template.sh" Mode="0644">
    <URL>&gitURL;scripts/agent-config-template.sh</URL>
    <MD5>{MD5_AGENTTMPL}</MD5>
  </FILE>
  <!-- 开机自启钩子：rc.M 不会遍历 /etc/rc.d/rc.*，故由 array started 事件拉起 -->
  <FILE Name="/usr/local/emhttp/plugins/dynamix/event/started/zz-wecomhub" Mode="0755">
    <URL>&gitURL;scripts/event-started.sh</URL>
    <MD5>{MD5_EVENT}</MD5>
  </FILE>
  <!-- 安装动作：不依赖 /boot/config/go -->
  <FILE Run="/bin/bash">
  <INLINE>
mkdir -p /usr/local/emhttp/plugins/&name;
echo "&version;" > /usr/local/emhttp/plugins/&name;/version

# 通知代理配置文件：不存在则生成；旧版 {0} 格式则用模板重建（含默认变量块，无 {0}）。
# 已存在则保留用户配置，因为该文件不在 &lt;FILE&gt; 清单中、不会被升级覆盖。
AGENT_CONF="/boot/config/plugins/dynamix/notifications/agents/&name;.sh"
AGENT_TPL="/usr/local/emhttp/plugins/&name;/scripts/agent-config-template.sh"
NEED_INIT=0
if [ ! -f "$AGENT_CONF" ]; then
  NEED_INIT=1
elif grep -q '^{0}$' "$AGENT_CONF" 2&gt;/dev/null; then
  cp -f "$AGENT_CONF" "$AGENT_CONF.bak-pre106" 2&gt;/dev/null || true
  NEED_INIT=1
fi
if [ "$NEED_INIT" = "1" ] &amp;&amp; [ -f "$AGENT_TPL" ]; then
  cp -f "$AGENT_TPL" "$AGENT_CONF"
  chmod 0755 "$AGENT_CONF"
fi

# 从持久化快照还原用户配置。
# 场景：agent 文件被 Delete 删掉、或仍是占位默认值，但快照里有真实值。
# 这样重装/升级后能自动拿回配置，而不是退回占位符。
SNAP="/boot/config/plugins/&name;/agent-vars.conf"
if [ -f "$SNAP" ] &amp;&amp; [ -f "$AGENT_TPL" ]; then
  NEEDS_RESTORE=0
  if [ ! -f "$AGENT_CONF" ]; then
    NEEDS_RESTORE=1
  elif grep -q 'RELAY_HOST="RELAY_HOST"' "$AGENT_CONF" 2&gt;/dev/null; then
    NEEDS_RESTORE=1
  fi
  if [ "$NEEDS_RESTORE" = "1" ]; then
    python3 - "$SNAP" "$AGENT_TPL" "$AGENT_CONF" &lt;&lt;'PYRESTORE'
import sys, re
snap, tpl, out = sys.argv[1:4]
vals = {}
for line in open(snap, encoding="utf-8", errors="ignore"):
    line = line.strip()
    if line and not line.startswith("#") and "=" in line:
        k, v = line.split("=", 1)
        vals[k] = v
if vals.get("RELAY_HOST", "RELAY_HOST") in ("", "RELAY_HOST"):
    sys.exit(0)
if vals.get("RELAY_PUSH_TOKEN", "RELAY_PUSH_TOKEN") in ("", "RELAY_PUSH_TOKEN"):
    sys.exit(0)
s = open(tpl, encoding="utf-8").read()
m = re.search(r"[#]{6,100}(.*?)[#]{6,100}", s, re.S)
if not m:
    sys.exit(0)
out_lines = []
for line in m.group(1).splitlines():
    if "=" not in line:
        continue
    k = line.split("=", 1)[0].strip()
    v = vals.get(k)
    if v is None:
        v = line.split("=", 1)[1].strip().strip(chr(34))
    out_lines.append(k + "=" + chr(34) + v + chr(34))
s = s[:m.start(1)] + "\n" + "\n".join(out_lines) + "\n" + s[m.end(1):]
open(out, "w", encoding="utf-8").write(s)
PYRESTORE
    chmod 0755 "$AGENT_CONF" 2&gt;/dev/null || true
  fi
fi

# 迁移：已存在但缺 export 的配置文件（v1.0.9 之前生成的），就地补上 export。
# 本文件用 exec 调用程序本体，未导出的变量不会传递过去，会导致通知静默失效。
# 只补 export 行，不动用户的变量值。
if [ -f "$AGENT_CONF" ] &amp;&amp; ! grep -q '^export RELAY_HOST' "$AGENT_CONF" 2&gt;/dev/null; then
  cp -f "$AGENT_CONF" "$AGENT_CONF.bak-preexport" 2&gt;/dev/null || true
  python3 - "$AGENT_CONF" &lt;&lt;'PYMIG'
import sys, re
p = sys.argv[1]
s = open(p, encoding="utf-8", errors="ignore").read()
if "export RELAY_HOST" in s:
    sys.exit(0)
m = re.search(r"[#]{6,100}(.*?)[#]{6,100}", s, re.S)
if not m:
    sys.exit(0)
ins = ("\n"
       "# Variables must be exported: this file uses exec to call the plugin body,\n"
       "# and unexported shell variables are not passed through.\n"
       "export RELAY_HOST RELAY_PORT RELAY_PUSH_TOKEN MIN_IMPORTANCE TITLE MESSAGE\n")
s = s[:m.end()] + ins + s[m.end():]
open(p, "w", encoding="utf-8").write(s)
PYMIG
  chmod 0755 "$AGENT_CONF" 2&gt;/dev/null || true
fi

# 指令服务开机钩子（若事件目录存在）
EVENT_DIR="/usr/local/emhttp/plugins/dynamix/event/started"
if [ -d "$EVENT_DIR" ] &amp;&amp; [ ! -f "$EVENT_DIR/zz-wecomhub" ]; then
  cp -f "/usr/local/emhttp/plugins/&name;/scripts/event-started.sh" "$EVENT_DIR/zz-wecomhub" 2&gt;/dev/null || true
  chmod 0755 "$EVENT_DIR/zz-wecomhub" 2&gt;/dev/null || true
fi

if [ -f /etc/rc.d/rc.&name; ]; then
  /etc/rc.d/rc.&name; restart &gt;/dev/null 2&gt;&amp;1 &amp;
fi
  </INLINE>
  </FILE>

  <!-- 卸载清理：停止服务并移除部署副本；保留 /boot/config/plugins/&name;/wecom.hub.cfg 用户配置 -->
  <FILE Run="/bin/bash" Method="remove">
  <INLINE>
if [ -x /etc/rc.d/rc.&name; ]; then
  /etc/rc.d/rc.&name; stop &gt;/dev/null 2&gt;&amp;1
fi
rm -f /etc/rc.d/rc.&name;
rm -f /boot/config/plugins/dynamix/notifications/agents/&name;.sh
rm -f /boot/config/plugins/dynamix/notifications/agents-disabled/&name;.sh
rm -f /usr/local/emhttp/plugins/dynamix/agents/&name;.xml
rm -f /usr/local/emhttp/plugins/dynamix/event/started/zz-wecomhub
rm -rf /usr/local/emhttp/plugins/&name;
# /boot/config/plugins/&name;/wecom.hub.cfg 保留，避免重装后需要重新填写
  </INLINE>
  </FILE>
</PLUGIN>
