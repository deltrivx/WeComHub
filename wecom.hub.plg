<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "WeComHub">
<!ENTITY author "deltrivx">
<!ENTITY version "{VERSION}">
<!ENTITY launch "Settings/Notification">
<!ENTITY branch "main">
<!ENTITY gitURL "https://github.com/deltrivx/WeComHub/raw/&branch;/">
<!ENTITY pluginURL "https://github.com/deltrivx/WeComHub">
<!ENTITY supportURL "https://github.com/deltrivx/WeComHub/issues">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;"
        pluginURL="&pluginURL;" supportURL="&supportURL;" min="6.9.0" beta="false">

  <!-- WeComHub：Unraid 企业微信中枢
       设置 → 通知 可视化配置；系统通知推送企微 + 企微指令反向交互。
       所有归档由 GitHub Actions 云端构建，禁止本地打包后上传。 -->

  <CHANGES>
### {VERSION}
- 设置 → 通知 → 通知代理 可视化配置入口
- 系统通知经中转转发至企业微信
- 内置本地指令服务，接收企微反向调用
- 阵列启动钩子开机自启，不再依赖 /boot/config/go
- 插件页显示完整描述

### 1.0.3
- 新增 plugins/WeComHub/README.md，修复插件页「描述」列空白
- RESTART_ALLOW_PREFIX 支持 * 通配，允许重启任意容器，无需逐个配置
- 修复 rc.WeComHub 在 busybox date 下日志时间戳空白
- 修复 rc.WeComHub 启动时与旧实例抢 8181 端口

### 1.0.2
- 新增通知代理定义 agents/WeComHub.xml
- 修复 verify-release.sh 占位符正则与 txz 目录校验误报

### 1.0.1
- 通知 payload 对齐现役中转侧（token + text 核心字段）
- 指令服务固定 POST /exec 并统一返回 JSON
- 指令支持中文别名（状态/磁盘/温度/阵列/重启）
- 「允许重启的容器名前缀」可在设置页配置，留空即禁用 restart
- 未配置令牌时指令服务 fail closed
- 修复版本索引与更新检查的字段名不一致

### 1.0.0
- 初始版本
  </CHANGES>

  <FILE Name="/usr/local/emhttp/plugins/&name;/&name;.page" Mode="0755">
    <URL>&gitURL;&name;.page</URL>
    <MD5>{MD5_PAGE}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/assets/&name;.css" Mode="0644">
    <URL>&gitURL;assets/&name;.css</URL>
    <MD5>{MD5_CSS}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/assets/&name;.js" Mode="0644">
    <URL>&gitURL;assets/&name;.js</URL>
    <MD5>{MD5_JS}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/wecom-hub-save.php" Mode="0755">
    <URL>&gitURL;wecom-hub-save.php</URL>
    <MD5>{MD5_SAVE}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/wecom-hub-update.php" Mode="0755">
    <URL>&gitURL;wecom-hub-update.php</URL>
    <MD5>{MD5_UPDATE}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/wecom-hub-notify-agent.sh" Mode="0755">
    <URL>&gitURL;wecom-hub-notify-agent.sh</URL>
    <MD5>{MD5_AGENT}</MD5>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/&name;/wecom-hub-cmd.py" Mode="0755">
    <URL>&gitURL;wecom-hub-cmd.py</URL>
    <MD5>{MD5_CMD}</MD5>
  </FILE>
  <!-- 插件页描述列：Unraid 插件管理器读取 plugins/<name>/README.md -->
  <FILE Name="/usr/local/emhttp/plugins/&name;/README.md" Mode="0644">
    <URL>&gitURL;README.plugin.md</URL>
    <MD5>{MD5_README}</MD5>
  </FILE>
  <!-- 通知代理定义：安装后出現在 设置 → 通知 → 通知代理，可在页面内填写并测试 -->
  <FILE Name="/usr/local/emhttp/plugins/dynamix/agents/&name;.xml" Mode="0644">
    <URL>&gitURL;agents/&name;.xml</URL>
    <MD5>{MD5_AGENTXML}</MD5>
  </FILE>
  <FILE Name="/etc/rc.d/rc.&name;" Mode="0755">
    <URL>&gitURL;scripts/rc.&name;</URL>
    <MD5>{MD5_RC}</MD5>
  </FILE>
  <FILE Name="/boot/config/plugins/dynamix/notifications/agents/&name;.sh" Mode="0755">
    <URL>&gitURL;scripts/notify-agent.sh</URL>
    <MD5>{MD5_AGENTSH}</MD5>
  </FILE>
  <!-- 开机自启钩子：rc.M 不会遍历 /etc/rc.d/rc.*，故由 array started 事件拉起 -->
  <FILE Name="/usr/local/emhttp/plugins/dynamix/event/started/zz-wecomhub" Mode="0755">
    <URL>&gitURL;scripts/event-started.sh</URL>
    <MD5>{MD5_EVENT}</MD5>
  </FILE>
  <!-- 安装/移除动作：不依赖 /boot/config/go -->
  <FILE Run="/bin/bash">
  <INLINE>
mkdir -p /usr/local/emhttp/plugins/&name;
echo "&version;" > /usr/local/emhttp/plugins/&name;/version
if [ -f /etc/rc.d/rc.&name; ]; then
  /etc/rc.d/rc.&name; restart &gt;/dev/null 2&gt;&amp;1 &amp;
fi
  </INLINE>
  </FILE>

  <!-- 卸载清理：停止服务并移除部署副本；保留 /boot/config/plugins/&name; 下的用户配置 -->
  <FILE Run="/bin/bash" Method="remove">
  <INLINE>
if [ -x /etc/rc.d/rc.&name; ]; then
  /etc/rc.d/rc.&name; stop &gt;/dev/null 2&gt;&amp;1
fi
rm -f /etc/rc.d/rc.&name;
rm -f /boot/config/plugins/dynamix/notifications/agents/&name;.sh
rm -f /boot/config/plugins/dynamix/notifications/agents-disabled/&name;.sh
rm -f /usr/local/emhttp/plugins/dynamix/agents/&name;.xml
rm -f /usr/local/emhttp/plugins/dynamix/event/started/zz-wecomhub
rm -rf /usr/local/emhttp/plugins/&name;
# /boot/config/plugins/&name;/wecom.hub.cfg 保留，避免重装后需要重新填写
  </INLINE>
  </FILE>
</PLUGIN>
